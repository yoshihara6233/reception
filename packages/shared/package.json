{
  "name": "@intereco/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared types and utilities for Intereco Recorder Monitor (monitor + edge-agent)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./nvr-adapter": {
      "types": "./src/nvr-adapter/index.ts",
      "import": "./src/nvr-adapter/index.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "import": "./src/constants.ts"
    },
    "./commands": {
      "types": "./src/commands.ts",
      "import": "./src/commands.ts"
    },
    "./baggage": {
      "types": "./src/baggage.ts",
      "import": "./src/baggage.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo 'shared: no lint configured'"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
