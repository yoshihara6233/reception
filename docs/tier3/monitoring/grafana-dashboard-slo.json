  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "死活成功率 (24h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(edge_heartbeat_total{result=\"ok\"}[24h])) / sum(rate(edge_heartbeat_total[24h]))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "yellow","value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "min": 0.9,
          "max": 1
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "コマンド成功率 (1h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(edge_commands_total{result=\"ok\"}[1h])) / sum(rate(edge_commands_total[1h]))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "yellow","value": 0.99 },
              { "color": "green", "value": 0.995 }
            ]
          }, "min": 0.9, "max": 1
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "稼働ノード数",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(up{job=\"intereco-edge-central\"})",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "yellow","value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "担当店舗数 (合計)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(edge_tenants_assigned)",
        "refId": "A"
      }],
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "コマンドレイテンシ p95 / p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(edge_command_duration_seconds_bucket[5m])) by (le, command))",
          "refId": "A", "legendFormat": "p95 {{command}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(edge_command_duration_seconds_bucket[5m])) by (le, command))",
          "refId": "B", "legendFormat": "p99 {{command}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "コマンド成功率 推移",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(edge_commands_total{result=\"ok\"}[5m])) / sum(rate(edge_commands_total[5m]))",
        "refId": "A", "legendFormat": "success rate"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "サーキットブレーカー OPEN 店舗数",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "edge_circuit_breaker_open_total",
        "refId": "A"
      }],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 15 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "担当店舗数 (ノード別)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "edge_tenants_assigned",
        "refId": "A", "legendFormat": "{{instance}}"
      }],
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 15 }
    }
  ],
