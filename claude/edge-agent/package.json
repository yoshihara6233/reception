{
  "name": "edge-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "spike:ipro-nu": "tsx src/spikes/ipro-nu-spike.ts",
    "spike:ipro-discover": "tsx src/spikes/ipro-nu-discover.ts"
  },
  "dependencies": {
    "@intereco/shared": "workspace:*",
    "@supabase/supabase-js": "^2.103.2",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.7"
  }
}
