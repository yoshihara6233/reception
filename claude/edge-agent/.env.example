# Cloud connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
EDGE_ID=00000000-0000-0000-0000-000000000000
EDGE_DEVICE_TOKEN=long-random-token

# LiveKit endpoint (required for live & VOD modes; grid mode doesn't use it).
# Same value the cloud uses; copy from monitor/.env.local LIVEKIT_URL.
LIVEKIT_URL=wss://your-project.livekit.cloud

# Local tooling
FFMPEG_BIN=/usr/bin/ffmpeg
GO2RTC_BIN=/usr/local/bin/go2rtc
TMP_DIR=/var/tmp/edge-agent

# Grid output
GRID_FPS=0.5
GRID_WIDTH=1280
GRID_HEIGHT=720
GRID_JPEG_QUALITY=6

# Heartbeat
HEARTBEAT_INTERVAL_MS=60000

# VOD watchdog: kill ffmpeg if no first frame within this window (ms).
VOD_FIRST_FRAME_TIMEOUT_MS=10000

# Frigate HTTP API port for VOD MP4 export. Default 5000 collides with macOS
# AirPlay Receiver — remap Docker to e.g. 5050:5000 and set this to 5050.
FRIGATE_API_PORT=5000

# 秘密情報 Vault化 (monitor と同一の鍵を設定)。openssl rand -base64 32
SECRETS_ENC_KEY=

# エッジ専用スコープ鍵化（docs/security-assessment.md §4.2）
# MONITOR_URL を設定すると bootstrap で鍵/短命トークンを pull する。
# EDGE_SCOPED_DB=true にすると全DB/Storageアクセスをエッジ専用の短命トークンで行い、
# service_role を実行経路から外す（B2 の RLS が本番に入っていることが前提）。
# MONITOR_URL は空文字だと URL 検証に落ちるため、使うときだけ行を有効化する。
#MONITOR_URL=https://intereco-monitor.vercel.app
EDGE_SCOPED_DB=
