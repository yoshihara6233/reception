# ローカル開発用 env テンプレ（ローカル Supabase スタックに向ける）。
# 使い方:
#   1) bun run db:start            # ローカル Supabase 起動(Docker/OrbStack)
#   2) supabase status             # 下の値(API URL / anon key / service_role key)を確認
#   3) このファイルを .env.local にコピーして値を貼る
#   4) bun run dev                 # http://127.0.0.1:3100
#
# ⚠ これは「本番を一切触らない」ローカル環境。値はローカル固定で秘密ではない。
#   本番キーは絶対にここへ書かない（本番は Vercel の env で管理）。

# ── Supabase (ローカルスタック) ──
# `supabase status` の "API URL"。既定は下記。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# `supabase status` の "anon key"(= publishable 相当)を貼る。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# `supabase status` の "service_role key"(= secret 相当)を貼る。
SUPABASE_SERVICE_ROLE_KEY=

# ── LiveKit (任意・ライブ視聴を試す時のみ) ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Edge command channel ──
EDGE_COMMAND_CHANNEL_PREFIX=edge:commands
