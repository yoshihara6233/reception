{
  "name": "monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:authz": "vitest run --config vitest.authz.config.ts",
    "test:schema-meta": "vitest run --config vitest.schema-meta.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:setup": "supabase start && supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint",
    "db:pull": "supabase db pull",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1090.0",
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter-tight": "^5.2.7",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@intereco/shared": "workspace:*",
    "@livekit/components-react": "^2.9.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.2",
    "@types/pdfkit": "^0.17.6",
    "hls.js": "^1.6.16",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "livekit-client": "^2.13.0",
    "livekit-server-sdk": "^2.13.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.9",
    "pdfkit": "^0.18.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^4.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.20",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pg": "^8.22.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
