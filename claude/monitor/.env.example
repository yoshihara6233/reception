# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxx

# Edge command channel
EDGE_COMMAND_CHANNEL_PREFIX=edge:commands

# 秘密情報 Vault化 (カメラ/VODパスワードの AES-256-GCM 暗号鍵)
# 生成: openssl rand -base64 32
# ⚠ Vercel と beelink(.env) に同じ値を設定すること。未設定なら plain: 運用にフォールバック。
SECRETS_ENC_KEY=
# 録画機の秘密はエッジごとの鍵 (enc:v2) で暗号化する (2026-10-29)。エッジにはマスタを渡さず、
# bootstrap でそのエッジの鍵 (HKDF で作る) だけを渡す。鍵を入れ替えるときは ID つきで複数並べる:
#   SECRETS_ENC_KEYS=k2:<新しい鍵>,k1:<以前の SECRETS_ENC_KEY>   (先頭が今の鍵)
# 入れ替えたら POST /api/admin/secrets/rewrap (運営) で包み直す。設定したら SECRETS_ENC_KEY より優先する。
# SECRETS_ENC_KEYS=
